<Window x:Class="WindowWatch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="460" Height="600" WindowStartupLocation="CenterOwner"
        Background="#FF1E2227" Foreground="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14" x:Name="Root">
            <TextBlock Text="Ollama" FontWeight="Bold" Foreground="#FF4E8CFF"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="地址" VerticalAlignment="Center" Grid.Row="0"/>
                <TextBox x:Name="HostBox" Grid.Row="0" Grid.Column="1" Margin="4,0"/>
                <TextBlock Text="模型" VerticalAlignment="Center" Grid.Row="1"/>
                <TextBox x:Name="ModelBox" Grid.Row="1" Grid.Column="1" Margin="4,2"/>
                <Button Content="校验连接" Grid.Row="2" Grid.Column="1" Margin="4,6,0,0" HorizontalAlignment="Left" Click="OnVerify"/>
            </Grid>

            <TextBlock Text="监控" FontWeight="Bold" Foreground="#FF4E8CFF" Margin="0,14,0,0"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="轮询间隔(ms)" VerticalAlignment="Center"/>
                <TextBox x:Name="PollBox" Grid.Column="1" Margin="4,0"/>
                <TextBlock Text="差异阈值(0-48)" VerticalAlignment="Center" Grid.Row="1"/>
                <TextBox x:Name="DHashBox" Grid.Column="1" Grid.Row="1" Margin="4,2"/>
                <TextBlock Text="冷却(秒)" VerticalAlignment="Center" Grid.Row="2"/>
                <TextBox x:Name="CooldownBox" Grid.Column="1" Grid.Row="2" Margin="4,2"/>
                <TextBlock Text="稳定帧数" VerticalAlignment="Center" Grid.Row="3"/>
                <TextBox x:Name="StableBox" Grid.Column="1" Grid.Row="3" Margin="4,2"/>
            </Grid>

            <TextBlock Text="停靠" FontWeight="Bold" Foreground="#FF4E8CFF" Margin="0,14,0,0"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="贴边位置" VerticalAlignment="Center"/>
                <ComboBox x:Name="EdgeCombo" Grid.Column="1" Margin="4,0">
                    <ComboBoxItem Content="右"/>
                    <ComboBoxItem Content="左"/>
                    <ComboBoxItem Content="上"/>
                    <ComboBoxItem Content="下"/>
                </ComboBox>
                <CheckBox x:Name="AutoHideBox" Content="自动隐藏" Grid.Row="1" Grid.Column="1" Margin="4,4"/>
                <CheckBox x:Name="AttachBox" Content="吸附被监控窗口边缘" Grid.Row="2" Grid.Column="1" Margin="4,4"/>
                <CheckBox x:Name="FreeMoveBox" Content="自由移动（拖到任意位置，不再贴边/吸附）" Grid.Row="3" Grid.Column="1" Margin="4,4"/>
            </Grid>

            <TextBlock Text="自动操作（安全）" FontWeight="Bold" Foreground="#FF4E8CFF" Margin="0,14,0,0"/>
            <CheckBox x:Name="AutoExecBox" Content="允许自动执行动作（建议保持关闭，仅给建议+手动）" Margin="0,6,0,0"/>
            <CheckBox x:Name="ConfirmBox" Content="每次动作前确认" Margin="0,4,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="保存" Width="90" Margin="0,0,8,0" Click="OnSave" IsDefault="True"/>
                <Button Content="取消" Width="90" Click="OnCancel" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
