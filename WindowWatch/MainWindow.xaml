<Window x:Class="WindowWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="窗哨 WindowWatch"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="330" Height="520" WindowStartupLocation="Manual"
        Loaded="OnLoaded" Closed="OnClosed">
    <Border Background="Transparent">
        <Border x:Name="RootPanel" CornerRadius="10" Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <!-- 收缩状态：可见的靠边把手 -->
                <Border x:Name="CollapsedTab" Visibility="Collapsed" Background="{StaticResource AccentBrush}"
                        CornerRadius="4" Margin="1">
                    <Ellipse Width="7" Height="7" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 展开状态：主面板 -->
                <Grid x:Name="MainPanel" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="2,0,2,8" Background="Transparent"
                           MouseLeftButtonDown="OnHeaderDrag">
                    <TextBlock Text="窗哨" Foreground="{StaticResource AccentBrush}"
                               FontWeight="Bold" FontSize="15" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SessionLabel" Text="未选择窗口" Foreground="{StaticResource DimBrush}"
                               FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left"
                               TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnAdd" Content="＋窗口" Click="OnAddWindow" Style="{StaticResource SmallBtn}" ToolTip="选择要监控的窗口"/>
                        <Button x:Name="BtnAnalyze" Content="分析" Click="OnAnalyzeNow" Style="{StaticResource SmallBtn}" ToolTip="立即分析当前画面"/>
                        <Button x:Name="BtnPause" Content="暂停" Click="OnTogglePause" Style="{StaticResource SmallBtn}" ToolTip="暂停/恢复监控"/>
                        <Button x:Name="BtnSettings" Content="⚙" Click="OnSettings" Style="{StaticResource SmallBtn}" ToolTip="设置"/>
                        <Button x:Name="BtnClose" Content="✕" Click="OnCloseClick" Style="{StaticResource SmallBtn}" ToolTip="退出（可最小化到托盘）"/>
                    </StackPanel>
                </DockPanel>

                <!-- 状态行 -->
                <Border x:Name="StatusBar" Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="6"
                        Padding="8,4" Margin="0,0,0,8">
                    <TextBlock x:Name="StatusText" Text="未连接 Ollama" Foreground="{StaticResource DimBrush}"
                               FontSize="11" TextWrapping="Wrap"/>
                </Border>

                <!-- 内容：会话 + 分析结果 -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 最新分析结果 -->
                        <TextBlock Text="最新分析" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                            <TextBlock x:Name="ResultText" Text="（暂无分析结果，窗口内容变化后自动分析）"
                                       Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <!-- 动作按钮 -->
                        <TextBlock Text="推荐动作" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ItemsControl x:Name="ActionList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,4" Padding="6,3" HorizontalContentAlignment="Left"
                                            Style="{StaticResource SmallBtn}"
                                            Click="OnActionClick" Tag="{Binding}">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 事件日志 -->
                        <TextBlock Text="事件日志" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <ItemsControl x:Name="LogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource DimBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部提示 -->
                <TextBlock Grid.Row="3" Text="悬停边缘展开 · 离开自动收缩 · Ctrl+Alt+W 呼出" Foreground="{StaticResource DimBrush}"
                           FontSize="10" Margin="2,8,2,0" HorizontalAlignment="Center"/>
            </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
